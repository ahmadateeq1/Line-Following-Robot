// ==========================================
// UTILITY FUNCTIONS 
// ==========================================
void exact_delay_ms(uint16_t ms) {
    for (uint16_t i = 0; i < ms; i++) __delay_ms(1);
}

void unlock_pps() {
    GIE = 0; PPSLOCK = 0x55; PPSLOCK = 0xAA; PPSLOCKED = 0;
}

void lock_pps() {
    PPSLOCK = 0x55; PPSLOCK = 0xAA; PPSLOCKED = 1; GIE = 1;
}

// ==========================================
// ULTRASONIC DISTANCE FUNCTION
// ==========================================
float get_distance_cm(void) {
    unsigned int time_us = 0;
    
    // Failsafe: clear stuck ECHO pin from a previous crash
    if (ECHO_PIN == 1) {
        TRIG_PIN = 0;
        exact_delay_ms(5); 
    }
    
    TRIG_PIN = 1;
    __delay_us(10);
    TRIG_PIN = 0;
    
    unsigned int timeout = 10000;
    while(ECHO_PIN == 0 && timeout > 0) timeout--;
    if(timeout == 0) return 999.0; 
    
    timeout = 30000; 
    while(ECHO_PIN == 1 && timeout > 0) {
        __delay_us(2);
        time_us += 2;
        timeout--;
    }
    
    return ((float)time_us * 0.01715);
}

// ==========================================
// MOTOR & HARDWARE CONTROL (MX1508 Logic)
// ==========================================
void set_motor_speeds(int left_speed, int right_speed) {
    if (left_speed >= 0) {
        if (left_dir != 1) { 
            PWM8DCH = 0;
            exact_delay_ms(5); 
            unlock_pps(); RD1PPS = 0x00; RD3PPS = 0x00; RD0PPS = 0x10; RD2PPS = 0x10; lock_pps();
            left_dir = 1;
        }
    } else {
        if (left_dir != -1) { 
            PWM8DCH = 0;
            exact_delay_ms(5); 
            unlock_pps(); RD0PPS = 0x00; RD2PPS = 0x00; RD1PPS = 0x10; RD3PPS = 0x10; lock_pps();
            left_dir = -1;
        }
        left_speed = -left_speed;
    }
    if (right_speed >= 0) {
        if (right_dir != 1) { 
            PWM6DCH = 0;
            exact_delay_ms(5); 
            unlock_pps(); RD5PPS = 0x00; RD6PPS = 0x00; RD4PPS = 0x0E; RD7PPS = 0x0E; lock_pps();
            right_dir = 1;
        }
    } else {
        if (right_dir != -1) { 
            PWM6DCH = 0;
            exact_delay_ms(5); 
            unlock_pps(); RD4PPS = 0x00; RD7PPS = 0x00; RD5PPS = 0x0E; RD6PPS = 0x0E; lock_pps();
            right_dir = -1;
        }
        right_speed = -right_speed;
    }
    if (left_speed > 255) left_speed = 255;
    if (right_speed > 255) right_speed = 255;
    PWM8DCH = (unsigned char)left_speed;
    PWM6DCH = (unsigned char)right_speed;
}

void pwm_initialize(void) {
    CCPTMRS1 = 0x55; T2CLKCON = 0x01;
    T2PR = 255; T2CON = 0b11000000;
    PWM8CON = 0b10000000; PWM6CON = 0b10000000;
    set_motor_speeds(0, 0);
}

void sensor_initialize(void) {
    ANSELB &= 0xE0; TRISB |= 0x1F;
    ANSELA &= 0xFC; 
    TRISA &= 0xFE;
    TRISA |= 0x02;  
    LATA &= 0xFE;   

    // --- Added Initialization for GY-31 and Servo ---
    // Clear analog flags for E
    ANSELE &= 0xF8; 
    
    // Set S0, S1, LED, S3 as Output
    TRISAbits.TRISA2 = 0; // S1
    TRISAbits.TRISA3 = 0; // S0
    TRISAbits.TRISA4 = 0; // LED
    TRISAbits.TRISA5 = 0; // S3
    
    // Set S2 and SERVO as Output, OUT as Input
    TRISEbits.TRISE0 = 0; // S2
    TRISEbits.TRISE1 = 1; // OUT (Input)
    TRISEbits.TRISE2 = 0; // SERVO
    
    // Turn on White LEDs
    LED_PIN = 1; 
    
    // Set Frequency Scaling to 20% (S0=HIGH, S1=LOW)
    S0 = 1;
    S1 = 0;
}

// ==========================================
// SEPARATE MODULE: COLOR SENSOR & SERVO
// ==========================================

// Custom microsecond delay needed for variable variables
void custom_delay_us(uint16_t us) {
    while(us--) {
        __delay_us(1);
    }
}

// Replicates Arduino's pulseIn(pin, LOW)
uint16_t get_color_pulse(void) {
    uint16_t timeout = 10000;
    uint16_t time_us = 0;
    
    // Wait for the pin to go HIGH then LOW
    while(OUT_PIN == 1 && timeout > 0) timeout--;
    if (timeout == 0) return 9999;
    
    timeout = 10000;
    // Measure how long it stays LOW
    while(OUT_PIN == 0 && timeout > 0) {
        __delay_us(1);
        time_us++;
        timeout--;
    }
    return time_us;
}

// Drives the servo to a specific angle (0 to 180)
void drive_servo_angle(int angle) {
    // Convert angle to microseconds (1000us to 2000us)
    int pulse_us = 1000 + (angle * 1000) / 180;
    
    // Send 10 pulses to give the servo time to physically move
    for(int i = 0; i < 10; i++) {
        SERVO_PIN = 1;
        custom_delay_us(pulse_us);
        SERVO_PIN = 0;
        exact_delay_ms(20); // 50Hz frequency
    }
}

// The main routine to check color and trigger the sweep
void process_color_sensor(void) {
    int redValue, greenValue, blueValue;
    const int THRESHOLD = 900;

    // Read Red
    S2 = 0; S3 = 0;
    redValue = get_color_pulse();
    
    // Read Green
    S2 = 1; S3 = 1;
    greenValue = get_color_pulse();
    
    // Read Blue
    S2 = 0; S3 = 1;
    blueValue = get_color_pulse();

    // Check if BLUE is dominant and below the threshold
    if (blueValue < redValue && blueValue < greenValue && blueValue <= THRESHOLD) {
        // "Starts rotating in all directions" -> Sweep routine
        drive_servo_angle(0);
        drive_servo_angle(90);
        drive_servo_angle(180);
        drive_servo_angle(90); // Return to neutral
    }
}
