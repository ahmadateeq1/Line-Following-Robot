// ==========================================
// MAIN EXECUTION
// ==========================================
void main(void) {
    OSCFRQ = 0x08; // 64MHz
    ANSELD = 0x00; TRISD = 0x00; LATD = 0x00;
    
    pwm_initialize();
    sensor_initialize();
    
    // Neutralize servo on startup
    drive_servo_angle(90); 
    
    exact_delay_ms(1000);

    while(1) {
        // ---- COLOR SENSOR MODULE CALL ----
        process_color_sensor(); 
        // ----------------------------------

        // Read Sensors (1 = Black, 0 = White)
        int s1 = (RB0 == 1) ? 1 : 0; // Left-most
        int s2 = (RB1 == 1) ? 1 : 0; 
        int s3 = (RB2 == 1) ? 1 : 0; // Middle
        int s4 = (RB3 == 1) ? 1 : 0; 
        int s5 = (RB4 == 1) ? 1 : 0; // Right-most

        // ==========================================
        // SENSOR-LOCKED JUNCTION GATEKEEPER
        // ==========================================
        int trigger_detected = 0;
        int next_j = junction_count + 1;

        // Target: Left Turns (new track 3, 7, 8, 13)
        if (next_j == 3 || next_j == 7 || next_j == 8 || next_j == 13) {
            if (s1 == 1 && s2 == 1 && s3 == 1) trigger_detected = 1;
        } 
        // Target: Right Turns (new track 14, and S3 J2 which is now 16)
        else if (next_j == 14 || next_j == 16) {
            if (s3 == 1 && s4 == 1 && s5 == 1) trigger_detected = 1;
        }
        // Target: J17 (left 3 turn on)
        else if (next_j == 17) {
            if (s1 == 1 && s2 == 1 && s3 == 1) trigger_detected = 1;
        }
        // Target: J18 & J19 (left most and middle turn on)
        else if (next_j == 18 || next_j == 19) {
            if (s1 == 1 && s3 == 1) trigger_detected = 1;
        }
        // Target: J20 (drift trigger: middle three turn on)
        else if (next_j == 20) {
            if (s2 == 1 && s3 == 1 && s4 == 1) trigger_detected = 1;
        }
        // Target: All See Black (Generic / straight crosses / stops)
        else {
            if (s1 == 1 && s2 == 1 && s3 == 1 && s4 == 1 && s5 == 1) trigger_detected = 1;
        }

        // ==========================================
        // Latch Increment & Execution Logic
        // ==========================================
        if (trigger_detected == 1 && in_junction == 0) {
            junction_count++;
            in_junction = 1; 

            // JUNCTIONS 3, 7: Simple Left Turns
            if (junction_count == 3 || junction_count == 7) {
                set_motor_speeds(base_speed, base_speed);
                exact_delay_ms(160);
                
                set_motor_speeds(-pivot_speed, pivot_speed);
                exact_delay_ms(280); 
                while(RB2 == 1);     
                while(RB2 == 0);     
                set_motor_speeds(0, 0);
                exact_delay_ms(50); 
                previous_error = 0; I = 0; in_junction = 0; 
                continue; 
            }
            
            // JUNCTION 8: Left Turn -> Ultrasonic -> 180 U-Turn
            else if (junction_count == 8) {
                set_motor_speeds(base_speed, base_speed);
                exact_delay_ms(160); 
                
                set_motor_speeds(-pivot_speed, pivot_speed); // Left Turn
                exact_delay_ms(280);
                while(RB2 == 1); 
                while(RB2 == 0); 
                set_motor_speeds(0, 0);
                exact_delay_ms(50); 
                previous_error = 0; I = 0;

                int stop_confidence = 0;
                int sensor_cooldown = 25; 
                int time_elapsed_ms = 0; // FAILSAFE TIMER
                float dist = 999.0;        

                while(1) {
                    sensor_cooldown++;
                    time_elapsed_ms += 2; // Add 2ms per loop for PID delay
                    
                    if (sensor_cooldown > 25) {
                        dist = get_distance_cm();
                        sensor_cooldown = 0;
                        time_elapsed_ms += 10; // Approx time sensor ping takes
                    }

                    // TIMEOUT FAILSAFE: 550ms Limit
                    if (time_elapsed_ms >= 550) {
                        set_motor_speeds(0, 0);
                        exact_delay_ms(1500);
                        break;
                    }

                    // SENSING RANGE: 6.0cm
                    if (dist > 1.0 && dist < 100.0) {
                        if (dist <= 6.0) stop_confidence++;
                        else if (dist > 6.5) stop_confidence = 0; 
                    }
                    
                    if (stop_confidence >= 2) {
                        set_motor_speeds(0, 0);
                        exact_delay_ms(1500); 
                        break; 
                    }
                    
                    int app_s1 = (RB0 == 1) ? 1 : 0; int app_s2 = (RB1 == 1) ? 1 : 0; 
                    int app_s3 = (RB2 == 1) ? 1 : 0; int app_s4 = (RB3 == 1) ? 1 : 0; 
                    int app_s5 = (RB4 == 1) ? 1 : 0;
                    
                    int app_err = 0;
                    if      ( app_s1 && !app_s2 && !app_s3 && !app_s4 && !app_s5) app_err = -10;
                    else if ( app_s1 &&  app_s2 && !app_s3 && !app_s4 && !app_s5) app_err = -6;
                    else if (!app_s1 &&  app_s2 && !app_s3 && !app_s4 && !app_s5) app_err = -3;
                    else if (!app_s1 &&  app_s2 &&  app_s3 && !app_s4 && !app_s5) app_err = -1;
                    else if (!app_s1 && !app_s2 &&  app_s3 &&  app_s4 && !app_s5) app_err =  0;
                    else if (!app_s1 && !app_s2 &&  app_s3 &&  app_s4 && !app_s5) app_err =  1;
                    else if (!app_s1 && !app_s2 && !app_s3 &&  app_s4 && !app_s5) app_err =  3;
                    else if (!app_s1 && !app_s2 && !app_s3 &&  app_s4 &&  app_s5) app_err =  6;
                    else if (!app_s1 && !app_s2 && !app_s3 && !app_s4 &&  app_s5) app_err =  10; 
                    
                    float app_P = app_err; I += app_err; float app_D = app_err - previous_error;
                    if (I > 50) I = 50; if (I < -50) I = -50;
                    float app_PID = (Kp * app_P) + (Ki * I) + (Kd * app_D);
                    previous_error = app_err;

                    set_motor_speeds(base_speed + (int)app_PID, base_speed - (int)app_PID);
                    exact_delay_ms(2);
                }
                
                // Perfect 180 U-Turn
                set_motor_speeds(pivot_speed, -pivot_speed);
                exact_delay_ms(450); 
                while(RB2 == 1);     
                while(RB2 == 0);     
                
                set_motor_speeds(-pivot_speed, pivot_speed);
                exact_delay_ms(50);
                
                set_motor_speeds(0, 0);
                exact_delay_ms(100); 
                previous_error = 0; I = 0; in_junction = 0; 
                continue;
            }

            // JUNCTION 10: Right Turn
            else if (junction_count == 10) {
                set_motor_speeds(base_speed, base_speed);
                exact_delay_ms(160); 
                
                set_motor_speeds(pivot_speed, -pivot_speed); 
                exact_delay_ms(280);
                while(RB2 == 1); 
                while(RB2 == 0); 
                set_motor_speeds(0, 0);
                exact_delay_ms(50); 
                previous_error = 0; I = 0; in_junction = 0; 
                continue;
            }

            // JUNCTION 11 & 12: Simple Line Follow
            else if (junction_count == 11 || junction_count == 12) {
                set_motor_speeds(base_speed, base_speed);
                exact_delay_ms(150);
                previous_error = 0; I = 0; in_junction = 0; 
                continue;
            }

            // JUNCTION 13: Left Turn -> Ultrasonic -> 180 U-Turn
            else if (junction_count == 13) {
                set_motor_speeds(base_speed, base_speed);
                exact_delay_ms(160); 
                
                set_motor_speeds(-pivot_speed, pivot_speed); 
                exact_delay_ms(280);
                while(RB2 == 1); 
                while(RB2 == 0); 
                set_motor_speeds(0, 0); 
                exact_delay_ms(50);
                previous_error = 0; I = 0;

                int stop_confidence = 0;
                int sensor_cooldown = 25; 
                int time_elapsed_ms = 0; // FAILSAFE TIMER
                float dist = 999.0;        

                while(1) {
                    sensor_cooldown++;
                    time_elapsed_ms += 2;
                    
                    if (sensor_cooldown > 25) {
                        dist = get_distance_cm();
                        sensor_cooldown = 0;
                        time_elapsed_ms += 10;
                    }

                    // TIMEOUT FAILSAFE: 550ms Limit
                    if (time_elapsed_ms >= 550) {
                        set_motor_speeds(0, 0);
                        exact_delay_ms(1500);
                        break;
                    }

                    // SENSING RANGE: 6.0cm
                    if (dist > 1.0 && dist < 100.0) {
                        if (dist <= 6.0) stop_confidence++;
                        else if (dist > 6.5) stop_confidence = 0; 
                    }
                    
                    if (stop_confidence >= 2) {
                        set_motor_speeds(0, 0);
                        exact_delay_ms(1500); 
                        break; 
                    }
                    
                    int app_s1 = (RB0 == 1) ? 1 : 0; int app_s2 = (RB1 == 1) ? 1 : 0; 
                    int app_s3 = (RB2 == 1) ? 1 : 0; int app_s4 = (RB3 == 1) ? 1 : 0; 
                    int app_s5 = (RB4 == 1) ? 1 : 0;
                    
                    int app_err = 0;
                    if      ( app_s1 && !app_s2 && !app_s3 && !app_s4 && !app_s5) app_err = -10;
                    else if ( app_s1 &&  app_s2 && !app_s3 && !app_s4 && !app_s5) app_err = -6;
                    else if (!app_s1 &&  app_s2 && !app_s3 && !app_s4 && !app_s5) app_err = -3;
                    else if (!app_s1 &&  app_s2 &&  app_s3 && !app_s4 && !app_s5) app_err = -1;
                    else if (!app_s1 && !app_s2 &&  app_s3 &&  app_s4 && !app_s5) app_err =  0;
                    else if (!app_s1 && !app_s2 &&  app_s3 &&  app_s4 && !app_s5) app_err =  1;
                    else if (!app_s1 && !app_s2 && !app_s3 &&  app_s4 && !app_s5) app_err =  3;
                    else if (!app_s1 && !app_s2 && !app_s3 &&  app_s4 &&  app_s5) app_err =  6;
                    else if (!app_s1 && !app_s2 && !app_s3 && !app_s4 &&  app_s5) app_err =  10; 
                    
                    float app_P = app_err; I += app_err; float app_D = app_err - previous_error;
                    if (I > 50) I = 50; if (I < -50) I = -50;
                    float app_PID = (Kp * app_P) + (Ki * I) + (Kd * app_D);
                    previous_error = app_err;

                    set_motor_speeds(base_speed + (int)app_PID, base_speed - (int)app_PID);
                    exact_delay_ms(2);
                }
                
                set_motor_speeds(pivot_speed, -pivot_speed);
                exact_delay_ms(450); 
                while(RB2 == 1);     
                while(RB2 == 0);     
                
                set_motor_speeds(-pivot_speed, pivot_speed);
                exact_delay_ms(50);
                
                set_motor_speeds(0, 0);
                exact_delay_ms(100);
                previous_error = 0; I = 0; in_junction = 0;
                continue;
            }

            // JUNCTION 14: Right Turn
            else if (junction_count == 14 ) {
                set_motor_speeds(base_speed, base_speed);
                exact_delay_ms(160); 
                
                set_motor_speeds(pivot_speed, -pivot_speed); 
                exact_delay_ms(280);
                while(RB2 == 1); 
                while(RB2 == 0); 
                set_motor_speeds(0, 0);
                exact_delay_ms(50); 
                previous_error = 0; I = 0; in_junction = 0; 
                continue;
            }

            // JUNCTION 15: Merge Point
            else if (junction_count == 15) {
                set_motor_speeds(base_speed, base_speed);
                exact_delay_ms(150); 
                previous_error = 0; I = 0; in_junction = 0; 
                continue;
            }

            // JUNCTION 16: Right Turn with Boost
            else if (junction_count == 16) {
                set_motor_speeds(220, -200);
                exact_delay_ms(300);
                while(RB2 ==1);
                while(RB2 == 0);
                
                base_speed = 165; 
                previous_error = 0; I = 0; in_junction = 0; 
                continue; 
            }

            // JUNCTION 17: Straight
            else if (junction_count == 17) {  
                base_speed= 165;
                set_motor_speeds(base_speed, base_speed);
                exact_delay_ms(150); 
                previous_error = 0; I = 0; in_junction = 0; 
                continue;
            }
            
            // JUNCTION 18 & 19: Stabilization Zone
            else if (junction_count == 18 || junction_count == 19) {  
                base_speed = 165;
                set_motor_speeds(base_speed, base_speed);
                exact_delay_ms(150); 
                previous_error = 0; I = 0; in_junction = 0; 
                continue;
            }

            // =========================================================
            // JUNCTION 20: The Reverse Slingshot
            // =========================================================
            else if (junction_count == 20) {  
                // 1. ALIGNMENT (Point nose to ramp)
                set_motor_speeds(-200, 220); 
                exact_delay_ms(180); 
                
                set_motor_speeds(0, 0);
                exact_delay_ms(50);
                
                // 2. THE RUN-UP: Reverse straight backwards blindly
                set_motor_speeds(-200, -200); 
                exact_delay_ms(450); 
                
                // 3. SETTLE
                set_motor_speeds(0, 0);
                exact_delay_ms(50);
                
                // 4. THE LAUNCH: Maximum power forward
                set_motor_speeds(255, 255);
                exact_delay_ms(1300); 
                
                previous_error = 0; I = 0; in_junction = 0;  
                continue;
            }

          
            // ==========================================
            // JUNCTION 21: Park Sequence
            // ==========================================
            else if (junction_count == 21) {
                // 1. FIRM STOP AT J21 
                set_motor_speeds(-150, -150); 
                exact_delay_ms(120); 
                set_motor_speeds(0, 0);        
                exact_delay_ms(1500);          
                
                // 2. RIGHT TURN
                set_motor_speeds(pivot_speed, -pivot_speed); 
                exact_delay_ms(280);
                while(RB2 == 1); 
                while(RB2 == 0); 
                set_motor_speeds(0, 0);
                exact_delay_ms(200); 
                previous_error = 0; I = 0; 
                
                // 3. FORWARD PID UNTIL ULTRASONIC DETECTS WALL
                int stop_confidence = 0;
                int sensor_cooldown = 25; 
                float dist = 999.0;        

                while(1) {
                    sensor_cooldown++;
                    
                    if (sensor_cooldown > 25) {
                        dist = get_distance_cm();
                        sensor_cooldown = 0;
                    }

                    // SENSING RANGE: 6.0cm
                    if (dist > 1.0 && dist < 100.0) {
                        if (dist <= 6.0) stop_confidence++;
                        else if (dist > 6.5) stop_confidence = 0; 
                    }
                    
                    if (stop_confidence >= 2) {
                        // IMMEDIATELY BRAKE AND STOP ASAP
                        set_motor_speeds(-150, -150); 
                        exact_delay_ms(100);
                        set_motor_speeds(0, 0);
                        exact_delay_ms(1000); 
                        break; // Move to reverse loop
                    }
                    
                    // Keep Line Following Forward
                    int app_s1 = (RB0 == 1) ? 1 : 0; int app_s2 = (RB1 == 1) ? 1 : 0; 
                    int app_s3 = (RB2 == 1) ? 1 : 0; int app_s4 = (RB3 == 1) ? 1 : 0; 
                    int app_s5 = (RB4 == 1) ? 1 : 0;
                    
                    int app_err = 0;
                    if      ( app_s1 && !app_s2 && !app_s3 && !app_s4 && !app_s5) app_err = -10;
                    else if ( app_s1 &&  app_s2 && !app_s3 && !app_s4 && !app_s5) app_err = -6;
                    else if (!app_s1 &&  app_s2 && !app_s3 && !app_s4 && !app_s5) app_err = -3;
                    else if (!app_s1 &&  app_s2 &&  app_s3 && !app_s4 && !app_s5) app_err = -1;
                    else if (!app_s1 && !app_s2 &&  app_s3 &&  app_s4 && !app_s5) app_err =  0;
                    else if (!app_s1 && !app_s2 && !app_s3 &&  app_s4 && !app_s5) app_err =  3;
                    else if (!app_s1 && !app_s2 && !app_s3 &&  app_s4 &&  app_s5) app_err =  6;
                    else if (!app_s1 && !app_s2 && !app_s3 && !app_s4 &&  app_s5) app_err =  10; 
                    
                    float app_P = app_err; I += app_err; float app_D = app_err - previous_error;
                    if (I > 50) I = 50; if (I < -50) I = -50;
                    float app_PID = (Kp * app_P) + (Ki * I) + (Kd * app_D);
                    previous_error = app_err;

                    set_motor_speeds(base_speed + (int)app_PID, base_speed - (int)app_PID);
                    exact_delay_ms(2);
                }
                
                // ==========================================
                // 4. REVERSE (NO PID) UNTIL J24
                // ==========================================
                int rev_junctions = 0;
                int rev_in_junction = 0;
                int rev_base_speed = -115; // Slow, controlled reverse speed
                
                set_motor_speeds(rev_base_speed, rev_base_speed);

                while(1) {
                    int app_s1 = (RB0 == 1) ? 1 : 0; int app_s2 = (RB1 == 1) ? 1 : 0; 
                    int app_s3 = (RB2 == 1) ? 1 : 0; int app_s4 = (RB3 == 1) ? 1 : 0; 
                    int app_s5 = (RB4 == 1) ? 1 : 0;
                    
                    // Detect Junctions in Reverse (Will cross 22, 23, and park on 24)
                    if (app_s1 && app_s2 && app_s3 && app_s4 && app_s5) {
                        if (rev_in_junction == 0) {
                            rev_junctions++;
                            rev_in_junction = 1;
                            
                            // 3rd Junction in reverse is J24
                            if (rev_junctions == 3) { 
                                // Reached J24! Stop the car completely.
                                set_motor_speeds(150, 150); // Hard Forward brake to kill momentum
                                exact_delay_ms(100);
                                set_motor_speeds(0, 0);
                                while(1); // Parked forever!
                            }
                        }
                    } else if (app_s1 == 0 && app_s5 == 0) {
                        rev_in_junction = 0; // Unlatch
                    }
                    
                    // Keep reversing straight blindly
                    set_motor_speeds(rev_base_speed, rev_base_speed);
                    exact_delay_ms(2);
                }
            }
        }
        
        // Strict Unlatch Logic 
        if (in_junction == 1 && s1 == 0 && s5 == 0) {
            in_junction = 0;
        }

        // ==========================================
        // SEARCH & RECOVER (CONFIDENCE FILTER)
        // ==========================================
        if (s1 == 0 && s2 == 0 && s3 == 0 && s4 == 0 && s5 == 0) {
            int line_confidence = 0;
            for (int i = 0; i < 3; i++) {
                exact_delay_ms(1);
                if ((RB0==1)||(RB1==1)||(RB2==1)||(RB3==1)||(RB4==1)) line_confidence++;
            }
            if (line_confidence < 2) {
                if (lost_line_flag == 0) {
                    int recovered = 0;
                    for (int t = 0; t < 150; t++) {
                        if ((RB0==1)||(RB1==1)||(RB2==1)||(RB3==1)||(RB4==1)) { recovered = 1; break; }
                        exact_delay_ms(1);
                    }
                    if (recovered) continue;
                    lost_line_flag = 1;
                }
                if (previous_error >= 0) set_motor_speeds(pivot_speed, -pivot_speed);
                else set_motor_speeds(-pivot_speed, pivot_speed);
                continue;
            }
        }

        // ==========================================
        // NON-LINEAR PID TRACKING
        // ==========================================
        lost_line_flag = 0;
        if      ( s1 && !s2 && !s3 && !s4 && !s5) error = -10;
        else if ( s1 &&  s2 && !s3 && !s4 && !s5) error = -6;
        else if (!s1 &&  s2 && !s3 && !s4 && !s5) error = -3;
        else if (!s1 &&  s2 &&  s3 && !s4 && !s5) error = -1;
        else if (!s1 && !s2 &&  s3 && !s4 && !s5) error =  0;
        else if (!s1 && !s2 &&  s3 &&  s4 && !s5) error =  1;
        else if (!s1 && !s2 && !s3 &&  s4 && !s5) error =  3;
        else if (!s1 && !s2 && !s3 &&  s4 &&  s5) error =  6;
        else if (!s1 && !s2 && !s3 && !s4 &&  s5) error =  10; 

        P = error;
        I += error; 
        D = error - previous_error;
        
        if (I > 50) I = 50;
        if (I < -50) I = -50;
        
        PID_value = (Kp * P) + (Ki * I) + (Kd * D);
        previous_error = error;
        
        set_motor_speeds(base_speed + (int)PID_value, base_speed - (int)PID_value);
        exact_delay_ms(2); 
    }
}
